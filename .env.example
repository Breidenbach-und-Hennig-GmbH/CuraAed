# HausPerfekt 2.0 (CuraAedificii) – environment variables
# Copy to your secret store / process environment. Never commit real values.
# All variables are optional; defaults are noted next to each one.

# --- Server -----------------------------------------------------------------
# HTTP port. The server always binds to 0.0.0.0. Default: 8080
PORT=

# --- Persistence --------------------------------------------------------------
# Path to the SQLite database file. Directory is created automatically.
# Default: <app>/data/hausverwaltung.db
DB_PATH=

# Directory for archive uploads (documents, photos). Created automatically.
# Default: <app>/data/uploads
UPLOAD_DIR=

# --- Initial administrator (used only when the user table is empty) ---------
# Default username: admin
ADMIN_BENUTZER=
# If blank, a random one-time password is generated and printed to stdout.
# Set a strong value for production, then change it after first login.
ADMIN_PASSWORT=

# --- Session cookie -----------------------------------------------------------
# Leave blank in production (HTTPS): cookie is Secure; SameSite=None; Partitioned.
# Set to 1 ONLY for plain-HTTP local development/testing (cookie becomes SameSite=Lax, not Secure).
COOKIE_INSECURE=

# --- Optional: HP-Mobile OAuth application ---------------------------------
# OAuth application credentials for the HP-Mobile connection. Server-side only.
# User portal passwords are forwarded for login, never persisted.
HP_MOBILE_CLIENT_ID=
HP_MOBILE_CLIENT_SECRET=
# Set to 1 for the HP-Mobile shutdown rehearsal. Blocks Mobile login, refresh,
# metadata and binary requests. Local archives and direct ERP connectors remain.
# Leave blank while migration is still using HP Mobile. No automatic date cutoff.
HP_MOBILE_DEAKTIVIERT=

# --- Optional: direct personal Plaud connection ----------------------------
# Public HTTPS origin, e.g. https://curaaed.onrender.com (no subpath).
# On Render, defaults to the platform's RENDER_EXTERNAL_URL.
APP_PUBLIC_URL=
# Optional 32-byte random key encoded as base64 for encrypting OAuth tokens.
# Without it, the app creates .plaud-token-key beside the persistent SQLite DB.
# Keep the key stable and include it in protected backups. Never commit it.
PLAUD_TOKEN_KEY=

# --- Optional: AI call summaries (Mistral, EU) ------------------------------
# Enables transcription + summary of Plaud recordings in "Telefoneingang".
# Without it, the feature reports "not configured" (HTTP 503); the rest of the app works.
MISTRAL_API_KEY=
# Chat model for summaries. Default: mistral-small-latest
MISTRAL_ZUSAMMENFASSUNG_MODELL=
